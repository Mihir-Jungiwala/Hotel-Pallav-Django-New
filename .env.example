# Copy this file to .env locally (or set these as real environment
# variables in your hosting platform) and fill in real values.
# Main/settings.py reads every one of these via os.environ.get(...).
# Unset = the fail-safe production default described in each comment below.

# --- Core Django settings -------------------------------------------------

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Set to True only for local development. Unset/False = production posture
# (secure cookies, HSTS, etc. — see the `if not DEBUG:` block in settings.py).
DJANGO_DEBUG=False

# Comma-separated list of hostnames this app is allowed to serve, e.g.
# DJANGO_ALLOWED_HOSTS=hotelpallav.example.com,www.hotelpallav.example.com
# Required whenever DJANGO_DEBUG=False — Django refuses every request with
# a 400 if this is empty and DEBUG is off.
DJANGO_ALLOWED_HOSTS=

# Comma-separated list of scheme://host origins allowed to POST here
# (needed for CSRF checks behind a reverse proxy), e.g.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hotelpallav.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave True unless you're intentionally serving plain HTTP (not
# recommended). Only read when DJANGO_DEBUG=False.
DJANGO_SECURE_SSL_REDIRECT=True

# --- Database --------------------------------------------------------------
# Leave both unset to use the local SQLite file (db.sqlite3) — fine for a
# single always-on server with light traffic, but NOT safe for multiple
# concurrent workers, and NOT USABLE AT ALL on a serverless host (Vercel
# and similar) where the filesystem is ephemeral. Set ONE of the two forms
# below for real production traffic — the psycopg2-binary driver needed
# for Postgres either way is already in requirements.txt.

# Option A — a single connection string. This is what Vercel (and
# Heroku/Render) automatically set when you attach a Postgres integration
# (Vercel Postgres, Neon, Supabase, etc.) — nothing else to configure:
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Option B — discrete credentials, for hosts that don't hand you one URL:
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=hotel_pallav
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=
# DJANGO_DB_PORT=5432
# DJANGO_DB_CONN_MAX_AGE=60

# --- Email (password reset) -------------------------------------------------
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Optional: S3-compatible media storage ----------------------------------
# Off by default — uploaded files (staff photos, resumes, invoice scans) are
# written to the local media/ directory, which is LOST on every
# deploy/restart if your host uses an ephemeral filesystem. Provision an
# actual bucket first, then set:

# DJANGO_USE_S3=True
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_S3_ENDPOINT_URL=
